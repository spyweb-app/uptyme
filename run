#!/usr/bin/env bash
set -e

cd "$(dirname "$0")"

# Parse arguments: --port, --no-test, -q/-qq
PORT_FLAG="--port 8000"
QUIET_FLAG="-q"
SKIP_TEST=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --port) PORT_FLAG="--port $2"; shift 2; continue ;;
    --port=*) PORT_FLAG="--port ${1#--port=}"; shift ;;
    --no-test) SKIP_TEST=true ;;
    -qq) QUIET_FLAG="-qq" ;;
    -q) QUIET_FLAG="-q" ;;
    *) echo "Unknown: $1"; exit 1 ;;
  esac
  shift
done

# Detect package manager
if command -v bun &>/dev/null; then
  PKG="bun"
elif command -v npm &>/dev/null; then
  PKG="npm"
else
  echo "Error: bun or npm is required to build the dashboard"
  echo "Install bun: https://bun.sh"
  echo "Install npm: https://nodejs.org"
  exit 1
fi

# Install dependencies if missing
if [ ! -d "dashboard/node_modules" ]; then
  echo "Installing dependencies with $PKG..."
  cd dashboard && $PKG install && cd ..
fi

# Run tests
if [ "$SKIP_TEST" = false ]; then
  echo "Running tests..."
  ./spyweb test
  if [ $? -ne 0 ]; then
    echo ""
    echo "SpyWeb Test Failed"
    exit 1
  fi
fi

# Build dashboard
echo "Building dashboard with $PKG..."
cd dashboard && $PKG run build && cd ..

# Start spyweb
echo "Starting spyweb..."
./spyweb start $PORT_FLAG $QUIET_FLAG
