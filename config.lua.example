-- UPTYME bootstrap configuration
--
-- This file is the main configuration for multi-node setup.
-- Keep secrets out of this file. Use environment variables for tokens.
--
-- Replace the placeholder values before first start.

return {

    -- Logging configuration (applies to all roles).
    -- level:  debug | info | warn | error | none  (default: error)
    -- output: file | terminal | both | none        (default: file)
    -- throttle: N = at most one log per N same-category occurrences; 0 or absent = off
    logging = { level = "error", output = "file", throttle = 6 },

    -- Activate cluster mode. When false, the node runs standalone and only `logging` applies.
	-- all settings below won't take effect unless multi_node is set to true
    multi_node = false,

    -- Role ("central" or "checker") only takes effect when multi_node is true.
    role = "central", -- "central" or "checker"

    -- Checker-only settings — only apply when role = "checker".
    -- Uncomment and fill these in to connect a checker to central.
    --[[
    -- Name this node reports to central (sent as the LOCAL_NAME header).
    node_name = "checker-PLACEHOLDER",

    -- Central instance URL.
    central_url = "https://central.example.com",

    -- Read the shared secret from an environment variable, not from disk.
    auth_token = env_get("UPTYME_CENTRAL_TOKEN"),

    -- Consecutive failed sync polls before "central unreachable" alert fires.
    central_alert_failures = 3,

    -- Checker connectivity alert options.
	-- Send alert to specific channel after this checker cannot connect to central for [central_alert_failures] times
    checker_alerts = {
      desktop = true,
      channels = {
        { type = "ntfy",    config = { url = "https://ntfy.sh", topic = "uptyme-checker" } },
        { type = "webhook", config = { url = "https://..." } },
        { type = "slack",   config = { url = "https://hooks.slack.com/services/T.../B.../XXX" } },
        { type = "discord", config = { url = "https://discord.com/api/webhooks/..." } },
      },
    },
    ]]
}
